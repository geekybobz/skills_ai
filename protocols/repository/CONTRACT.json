{
  "version": 1,
  "protocol_version": 10,
  "approval_operations": [
    "move",
    "deprecate",
    "delete",
    "install",
    "scope",
    "protocol"
  ],
  "protected_prefixes": [
    "design-with-claude/",
    "interaction-protocol/",
    "theory-reference/"
  ],
  "request_inbox": "requests/pending",
  "generated_outputs": {
    "AGENTS.md": {
      "source_patterns": [
        "runtime/AGENT_ENTRY_SHARED.md",
        "adapters/codex/ENTRY.md",
        "scripts/compile_repository_views.py",
        "protocols/repository/DOCUMENTATION.json"
      ],
      "check": "views"
    },
    "CLAUDE.md": {
      "source_patterns": [
        "runtime/AGENT_ENTRY_SHARED.md",
        "adapters/claude/ENTRY.md",
        "scripts/compile_repository_views.py",
        "protocols/repository/DOCUMENTATION.json"
      ],
      "check": "views"
    },
    "docs/human/_LIVE_REPOSITORY_INDEX.md": {
      "source_patterns": [
        ".gitignore",
        ".gitmodules",
        ".obsidian/**",
        "adapters/**",
        "cards/**",
        "design-with-claude/**",
        "docs/**",
        "external-skills/**",
        "interaction-protocol/**",
        "protocols/**",
        "research-context-scout/**",
        "registry/**",
        "requests/**",
        "runtime/**",
        "scripts/**",
        "tests/**",
        "theory-reference"
      ],
      "check": "views"
    },
    "docs/human/_LIVE_SKILL_CATALOG.md": {
      "source_patterns": [
        "docs/00_SKILLS_HUB.md",
        "registry/**",
        "design-with-claude/**",
        "interaction-protocol/**",
        "theory-reference",
        "external-skills/**",
        "research-context-scout/**",
        "protocols/repository/DOCUMENTATION.json",
        "scripts/compile_repository_views.py"
      ],
      "check": "views"
    },
    "runtime/router-manifest.json": {
      "source_patterns": [
        "interaction-protocol/protocol.json",
        "docs/00_SKILLS_HUB.md",
        "registry/**"
      ],
      "check": "registry"
    }
  },
  "ignored_worktree_patterns": [
    ".runtime/**",
    "sample_resources/**"
  ],
  "user_owned_paths": [
    ".obsidian/graph.json"
  ],
  "allowed_external_symlinks": [
    "external-skills/quantum-job-collector"
  ],
  "roles": [
    {
      "id": "platform-entry",
      "patterns": ["AGENTS.md", "CLAUDE.md"],
      "checks": ["consistency", "human-docs", "unit", "views"]
    },
    {
      "id": "human-guide",
      "patterns": ["README.md", "docs/human/**", "research-context-scout/README.md"],
      "checks": ["consistency", "graph", "human-docs", "views"]
    },
    {
      "id": "governance",
      "patterns": [
        "docs/03_COMBO_MAP.md",
        "docs/04_RISK_MAP.md",
        "docs/05_COLOR_LAYERS.md",
        "docs/06_CHANGE_CONTROL.md",
        "docs/07_BUILD_AND_RELEASE.md",
        "protocols/repository/**"
      ],
      "checks": ["consistency", "graph", "human-docs", "unit", "views"]
    },
    {
      "id": "registry-source",
      "patterns": [
        "docs/00_SKILLS_HUB.md",
        "registry/**",
        "interaction-protocol/**"
      ],
      "checks": ["consistency", "graph", "human-docs", "registry", "unit", "views"]
    },
    {
      "id": "skill-source",
      "patterns": [
        "design-with-claude/*.md",
        "external-skills/**/SKILL.md",
        "research-context-scout/SKILL.md",
        "theory-reference/SKILL.md",
        "theory-reference/shared/SKILL.md"
      ],
      "checks": ["consistency", "graph", "registry", "unit", "views"]
    },
    {
      "id": "skill-plan-draft",
      "patterns": ["skill-plans/*/plan.md"],
      "checks": []
    },
    {
      "id": "skill-support",
      "patterns": [
        "external-skills/**",
        "research-context-scout/**",
        "theory-reference/shared/phases/**"
      ],
      "checks": ["consistency", "graph", "unit", "views"]
    },
    {
      "id": "shared-runtime",
      "patterns": [
        "runtime/**",
        "scripts/benchmark_router.py",
        "scripts/compile_registry.py",
        "scripts/list_registry.py",
        "scripts/registry_runtime.py",
        "scripts/route_skill.py",
        "scripts/toggle_registry.py",
        "scripts/validate_registry.py"
      ],
      "checks": ["benchmark", "consistency", "human-docs", "lifecycle", "registry", "unit", "views"]
    },
    {
      "id": "maintenance-runtime",
      "patterns": [
        "scripts/change_guard.py",
        "scripts/analyze_ambiguities.py",
        "scripts/compile_repository_views.py",
        "scripts/create_change_request.py",
        "scripts/graph_layers.py",
        "scripts/human_docs_guard.py",
        "scripts/scan_consistency.py"
      ],
      "checks": ["consistency", "graph", "human-docs", "unit", "views"]
    },
    {
      "id": "platform-adapter",
      "patterns": ["adapters/**", "scripts/install_runtime_adapter.py"],
      "checks": ["adapter", "consistency", "human-docs", "unit", "views"]
    },
    {
      "id": "test-source",
      "patterns": ["tests/**"],
      "checks": ["consistency", "unit", "views"]
    },
    {
      "id": "graph-configuration",
      "patterns": [".obsidian/graph.json", "docs/05_COLOR_LAYERS.md"],
      "checks": ["graph", "human-docs", "views"]
    },
    {
      "id": "change-request",
      "patterns": ["requests/**"],
      "checks": ["change-request", "consistency", "graph", "views"]
    },
    {
      "id": "repository-support",
      "patterns": [
        ".gitignore",
        ".gitmodules",
        ".obsidian/*.json",
        "cards/**",
        "docs/*.md",
        "docs/CLAUDE_VERIFICATION_PROMPT.md",
        "docs/INTERACTION_PROTOCOL_MIGRATION.md",
        "docs/SKILLS.md",
        "theory-reference"
      ],
      "checks": ["consistency", "graph", "views"]
    },
    {
      "id": "ignored-sample",
      "patterns": ["sample_resources/**"],
      "checks": []
    },
    {
      "id": "ignored-runtime-state",
      "patterns": [".runtime/**"],
      "checks": []
    }
  ],
  "graph_role_policy": {
    "graph_contract_entry_layer": "L1",
    "required_paths": {
      "registry/activation.md": "L1",
      "registry/design.md": "L2",
      "cards/legacy/quantum-job-collector.md": "L3",
      "design-with-claude/poster-lead.md": "L4",
      "research-context-scout/SKILL.md": "L4",
      "runtime/PROTOCOL.md": "L5"
    }
  },
  "graph_contracts": [
    {
      "id": "interaction-protocol",
      "entry": "interaction-protocol/README.md",
      "canonical_sources": ["interaction-protocol/protocol.json"],
      "required_links": {
        "docs/00_SKILLS_HUB.md": [
          "registry/interaction",
          "interaction-protocol/README"
        ],
        "registry/interaction.md": [
          "docs/00_SKILLS_HUB",
          "registry/activation",
          "interaction-protocol/README",
          "runtime/PROTOCOL"
        ],
        "interaction-protocol/README.md": [
          "docs/00_SKILLS_HUB",
          "registry/activation",
          "registry/interaction",
          "runtime/PROTOCOL",
          "runtime/API_CONTRACT",
          "docs/INTERACTION_PROTOCOL_MIGRATION"
        ],
        "docs/INTERACTION_PROTOCOL_MIGRATION.md": ["interaction-protocol/README"],
        "runtime/README.md": ["interaction-protocol/README"],
        "runtime/PROTOCOL.md": ["interaction-protocol/README"],
        "runtime/API_CONTRACT.md": ["interaction-protocol/README"]
      }
    },
    {
      "id": "repository-maintenance",
      "entry": "docs/06_CHANGE_CONTROL.md",
      "canonical_sources": [
        "protocols/repository/CONTRACT.json",
        "scripts/scan_consistency.py"
      ],
      "required_links": {
        "docs/06_CHANGE_CONTROL.md": [
          "docs/07_BUILD_AND_RELEASE",
          "protocols/repository/PROTOCOL_AMENDMENT",
          "docs/human/07_MAINTAINING_SKILLS"
        ],
        "docs/07_BUILD_AND_RELEASE.md": ["docs/06_CHANGE_CONTROL"],
        "protocols/repository/PROTOCOL_AMENDMENT.md": ["docs/06_CHANGE_CONTROL"]
      }
    },
    {
      "id": "shared-documentation",
      "entry": "docs/SHARED_DOCUMENTATION_MODEL.md",
      "canonical_sources": [
        "protocols/repository/DOCUMENTATION.json",
        "runtime/AGENT_ENTRY_SHARED.md",
        "scripts/compile_repository_views.py"
      ],
      "required_links": {
        "docs/SHARED_DOCUMENTATION_MODEL.md": [
          "docs/06_CHANGE_CONTROL",
          "docs/human/08_REPOSITORY_ATLAS",
          "docs/human/09_SKILL_ANATOMY"
        ],
        "protocols/repository/PROTOCOL_AMENDMENT.md": [
          "docs/SHARED_DOCUMENTATION_MODEL"
        ],
        "runtime/AGENT_ENTRY_SHARED.md": [
          "docs/SHARED_DOCUMENTATION_MODEL"
        ],
        "adapters/codex/ENTRY.md": [
          "docs/SHARED_DOCUMENTATION_MODEL"
        ],
        "adapters/claude/ENTRY.md": [
          "docs/SHARED_DOCUMENTATION_MODEL"
        ]
      }
    }
  ]
}
