        "requests/**"
      ],
      "checks": [
        "change-request",
        "consistency",
        "graph",
        "views"
      ]
    },
    {
      "id": "repository-support",
      "patterns": [
        ".gitignore",
        ".gitmodules",
        ".obsidian/*.json",
        "cards/**",
        "docs/*.md",
        "docs/CLAUDE_VERIFICATION_PROMPT.md",
        "docs/INTERACTION_PROTOCOL_MIGRATION.md",
        "docs/SKILLS.md",
        "theory-reference"
      ],
      "checks": [
        "consistency",
        "graph",
        "views"
      ]
    },
    {
      "id": "ignored-sample",
      "patterns": [
        "sample_resources/**"
      ],
      "checks": []
    },
    {
      "id": "ignored-runtime-state",
      "patterns": [
        ".runtime/**"
      ],
      "checks": []
    }
