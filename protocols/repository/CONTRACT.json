        "scripts/create_change_request.py",
        "scripts/graph_layers.py",
        "scripts/human_docs_guard.py",
        "scripts/scan_consistency.py"
      ],
      "checks": [
        "consistency",
        "graph",
        "human-docs",
        "unit",
        "views"
      ]
    },
    {
      "id": "platform-adapter",
      "patterns": [
        "adapters/**",
        "scripts/install_runtime_adapter.py"
      ],
      "checks": [
        "adapter",
        "consistency",
        "human-docs",
        "unit",
        "views"
      ]
    },
    {
      "id": "test-source",
      "patterns": [
        "tests/**"
      ],
      "checks": [
        "consistency",
        "unit",
        "views"
      ]
    },
    {
      "id": "graph-entry",
      "patterns": [
        "graph/**"
      ],
      "checks": [
        "consistency",
        "graph",
        "human-docs",
        "views"
      ]
    },
    {
      "id": "graph-configuration",
