  "graph_role_policy": {
    "graph_contract_entry_layer": "L1",
    "required_paths": {
      "registry/activation.md": "L1",
      "graph/orchestration/skills-orchestrator.md": "L1",
      "registry/theory.md": "L2",
      "cards/legacy/quantum-job-collector.md": "L3",
      "optimizer/SKILL.md": "L4",
      "graph/skills/optimizer.md": "L4",
      "graph/skills/research-context-scout.md": "L4",
      "runtime/PROTOCOL.md": "L5"
    }
  },
  "graph_inventory_policy": {
    "documentation_model": "protocols/repository/DOCUMENTATION.json",
    "orchestrator_layer": "L1",
    "skill_layer": "L4",
    "reserved_entry_names": [
      "SKILL.md",
      "README.md",
      "CLAUDE.md",
      "CODEX.md",
      "ENTRY.md"
    ],
    "require_default_visibility": true
