{
  "version": 1,
  "protocol_version": 16,
  "approval_operations": [
    "move",
    "deprecate",
    "delete",
    "install",
    "scope",
    "protocol"
  ],
  "protected_prefixes": [
    "interaction-protocol/",
    "runtime/skills-orchestrator/",
    "theory-reference/"
  ],
  "request_inbox": "requests/pending",
  "generated_outputs": {
    "AGENTS.md": {
      "source_patterns": [
        "runtime/AGENT_ENTRY_SHARED.md",
        "adapters/codex/ENTRY.md",
        "scripts/compile_repository_views.py",
        "protocols/repository/DOCUMENTATION.json"
      ],
      "check": "views"
    },
    "CLAUDE.md": {
      "source_patterns": [
        "runtime/AGENT_ENTRY_SHARED.md",
        "adapters/claude/ENTRY.md",
        "scripts/compile_repository_views.py",
        "protocols/repository/DOCUMENTATION.json"
      ],
      "check": "views"
    },
    "docs/human/_LIVE_REPOSITORY_INDEX.md": {
      "source_patterns": [
        ".gitignore",
        ".gitmodules",
        ".obsidian/**",
        "adapters/**",
        "cards/**",
        "docs/**",
        "external-skills/**",
        "graph/**",
        "interaction-protocol/**",
        "optimizer/**",
        "protocols/**",
        "research-context-scout/**",
        "registry/**",
        "requests/**",
        "runtime/**",
        "scripts/**",
        "tests/**",
        "theory-reference"
      ],
      "check": "views"
    },
    "docs/human/_LIVE_SKILL_CATALOG.md": {
      "source_patterns": [
        "docs/00_SKILLS_HUB.md",
        "registry/**",
        "interaction-protocol/**",
        "theory-reference",
        "external-skills/**",
        "optimizer/**",
        "runtime/skills-orchestrator/**",
        "research-context-scout/**",
        "protocols/repository/DOCUMENTATION.json",
        "scripts/compile_repository_views.py"
      ],
      "check": "views"
    },
    "runtime/manifest.json": {
      "source_patterns": [
        "interaction-protocol/protocol.json",
        "docs/00_SKILLS_HUB.md",
        "registry/**"
      ],
      "check": "registry"
    },
    "graph/orchestration/skills-orchestrator.md": {
      "source_patterns": [
        "registry/activation.md",
        "protocols/repository/DOCUMENTATION.json",
        "scripts/compile_repository_views.py"
      ],
      "check": "views"
    },
    "graph/skills/interaction-protocol.md": {
      "source_patterns": [
        "registry/activation.md",
        "protocols/repository/DOCUMENTATION.json",
        "scripts/compile_repository_views.py"
      ],
      "check": "views"
    },
    "graph/skills/theory-reference.md": {
      "source_patterns": [
        "registry/activation.md",
        "protocols/repository/DOCUMENTATION.json",
        "scripts/compile_repository_views.py"
      ],
      "check": "views"
    },
    "graph/skills/research-context-scout.md": {
      "source_patterns": [
        "registry/activation.md",
        "protocols/repository/DOCUMENTATION.json",
        "scripts/compile_repository_views.py"
      ],
      "check": "views"
    },
    "graph/skills/optimizer.md": {
      "source_patterns": [
        "registry/activation.md",
        "protocols/repository/DOCUMENTATION.json",
        "scripts/compile_repository_views.py"
      ],
      "check": "views"
    },
    "graph/skills/quantum-job-collector.md": {
      "source_patterns": [
        "registry/activation.md",
        "protocols/repository/DOCUMENTATION.json",
        "scripts/compile_repository_views.py"
      ],
      "check": "views"
    }
  },
  "ignored_worktree_patterns": [
    ".runtime/**",
    "feedback-tickets/**",
    "sample_resources/**"
  ],
  "user_owned_paths": [
    ".obsidian/graph.json"
  ],
  "allowed_external_symlinks": [
    "external-skills/quantum-job-collector"
  ],
  "roles": [
    {
      "id": "platform-entry",
      "patterns": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "checks": [
        "consistency",
        "human-docs",
        "unit",
        "views"
      ]
    },
    {
      "id": "human-guide",
      "patterns": [
        "README.md",
        "docs/human/**",
        "research-context-scout/README.md"
      ],
      "checks": [
        "consistency",
        "graph",
        "human-docs",
        "views"
      ]
    },
    {
      "id": "governance",
