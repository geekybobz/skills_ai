      "checks": [
        "consistency",
        "graph",
        "registry",
        "unit",
        "views"
      ]
    },
    {
      "id": "skill-plan-draft",
      "patterns": [
        "skill-plans/*/plan.md"
      ],
      "checks": []
    },
    {
      "id": "skill-support",
      "patterns": [
        "external-skills/**",
        "optimizer/**",
        "research-context-scout/**",
        "theory-reference/shared/phases/**"
