{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills-ai/project-context/1",
  "title": "Skills AI project context capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "routing",
    "constraints",
    "documentation",
    "checkpoint",
    "freshness"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "routing": {
      "$ref": "#/$defs/routing"
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "documentation": {
      "$ref": "#/$defs/documentation"
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "shortString": {
      "type": "string",
      "maxLength": 160
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "identifierList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "relativePathList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/shortString"
        },
        "kind": {
          "$ref": "#/$defs/shortString"
        },
        "languages": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortString"
          }
        },
        "frameworks": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/shortString"
          }
        },
        "entrypoints": {
          "$ref": "#/$defs/relativePathList"
        },
        "commands": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_packages": {
          "$ref": "#/$defs/identifierList"
        },
        "excluded_packages": {
          "$ref": "#/$defs/identifierList"
        },
        "manual_only": {
          "$ref": "#/$defs/identifierList"
        },
        "capability_hints": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "write_scope": {
          "$ref": "#/$defs/relativePathList"
        },
        "protected_paths": {
          "$ref": "#/$defs/relativePathList"
        },
        "network": {
          "enum": [
            "ask",
            "deny"
          ]
        },
        "credentials": {
          "const": "never-store"
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_sources": {
          "$ref": "#/$defs/relativePathList"
        },
        "generated_outputs": {
          "$ref": "#/$defs/relativePathList"
        },
        "validation_commands": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": "string",
          "maxLength": 512
        },
        "phase": {
          "$ref": "#/$defs/shortString"
        },
        "approved_scope": {
          "$ref": "#/$defs/relativePathList"
        },
        "next_condition": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verified_at": {
          "type": "string",
          "maxLength": 64
        },
        "manifest_source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
